[Unit]
Description=Persistent Paseo Bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=paseo-bridge
Group=paseo-bridge
ExecStart=/usr/bin/node /opt/paseo-bridge/paseo-bridge-server.mjs --config /etc/paseo-bridge/bridge.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
RuntimeDirectory=paseo-bridge
RuntimeDirectoryMode=0750
StateDirectory=paseo-bridge
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/paseo-bridge
ReadWritePaths=/var/lib/paseo-bridge /run/paseo-bridge
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
